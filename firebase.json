{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "ignore": ["node_modules", ".git", "*.local", "*.test.mjs"]
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/visit-location",
        "function": { "functionId": "recordVisitLocation", "region": "us-central1" }
      },
      {
        "source": "/api/email-preferences",
        "function": { "functionId": "unsubscribeEmail", "region": "us-central1" }
      },
      {
        "source": "/api/postmark-events",
        "function": { "functionId": "recordPostmarkEvent", "region": "us-central1" }
      },
      {
        "source": "/api/lead-lifecycle",
        "function": { "functionId": "recordLeadLifecycle", "region": "us-central1" }
      },
      {
        "source": "/api/hybrid-outbound-events",
        "function": { "functionId": "recordHybridCallEvent", "region": "us-central1" }
      },
      {
        "source": "/api/twilio-prospect-twiml",
        "function": { "functionId": "twilioHybridProspectTwiML", "region": "us-central1" }
      },
      {
        "source": "/api/twilio-browser-twiml",
        "function": { "functionId": "twilioHybridBrowserTwiML", "region": "us-central1" }
      },
      {
        "source": "/api/twilio-conference-events",
        "function": { "functionId": "twilioHybridConferenceEvent", "region": "us-central1" }
      },
      {
        "source": "/api/twilio-ai-participant-twiml",
        "function": { "functionId": "twilioHybridAIParticipantTwiML", "region": "us-central1" }
      },
      {
        "source": "/api/twilio-ai-sip-events",
        "function": { "functionId": "twilioHybridAISipEvent", "region": "us-central1" }
      },
      {
        "source": "/api/twilio-hybrid-voicemail",
        "function": { "functionId": "twilioHybridVoicemailTwiML", "region": "us-central1" }
      },
      {
        "source": "/api/hybrid-ai-media",
        "function": { "functionId": "hybridAIMediaControl", "region": "us-central1" }
      },
      {
        "source": "/api/hybrid-sideband-control",
        "function": { "functionId": "hybridSidebandControl", "region": "us-central1" }
      },
      {
        "source": "/api/openai-realtime-incoming",
        "function": { "functionId": "openAIRealtimeIncomingCall", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8085 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}

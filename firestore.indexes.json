        { "fieldPath": "duplicate.status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    { "//": "prospect-deduplication.findDuplicates — the cross-batch fuzzy pass, an exact match on the normalised company key. Equality-only, so Firestore's automatic single-field index serves it; listed here as documentation of the dependency.",

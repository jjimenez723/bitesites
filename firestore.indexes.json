      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "direction", "order": "ASCENDING" },
        { "fieldPath": "startedAt", "order": "DESCENDING" }
      ]
    },
    { "//": "outbound-calls.recordCallEvent — matching a webhook back to its call.",
      "collectionGroup": "calls",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "targetId", "order": "ASCENDING" },
        { "fieldPath": "startedAt", "order": "DESCENDING" }
      ]
    },

    { "//": "ProspectList — the default review queue ordering.",
      "collectionGroup": "prospects",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "lifecycle.status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    { "//": "ProspectList — filtering an import batch by where it came from.",
      "collectionGroup": "prospects",

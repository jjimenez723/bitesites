    { "//": "Outbound calling. Every index below backs a query that exists in the code — see the module named in each comment. Firestore serves single-field equality from automatic indexes, so nothing here duplicates one.",
      "collectionGroup": "calls",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "campaignId", "order": "ASCENDING" },
        { "fieldPath": "startedAt", "order": "DESCENDING" }

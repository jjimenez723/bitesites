{
  "name": "bitesites-react-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "setup": "node scripts/hybrid.mjs setup",
    "preflight:hybrid": "node scripts/hybrid.mjs preflight",
    "configure:hybrid": "node scripts/hybrid.mjs configure",
    "validate:hybrid": "node scripts/hybrid.mjs validate",
    "dry-run:hybrid": "node scripts/hybrid.mjs dry-run",
    "configure:staging": "node scripts/staging.mjs configure",
    "preflight:staging": "node scripts/staging.mjs preflight",
    "dry-run:staging": "node scripts/staging.mjs dry-run",
    "deploy:staging": "node scripts/staging.mjs deploy",
    "bootstrap:sideband": "node scripts/hybrid.mjs bootstrap-sideband",
    "deploy:hybrid": "node scripts/hybrid.mjs deploy",
    "dev": "vite",
    "build": "vite build",
    "check": "npm run build",
    "secrets:check": "node scripts/check-no-secrets.mjs",
    "og": "node scripts/capture-og.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "emulators": "firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bitesites \"node scripts/test-rules.mjs\"",
    "test:voice": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/voice-webhook.test.mjs\"",
    "test:lifecycle": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/lifecycle-webhook.test.mjs\"",
    "test:analytics": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/analytics-aggregate.test.mjs\"",
    "test:import": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/voice-import.test.mjs\"",
    "test:role": "firebase emulators:exec --only firestore,auth --project demo-bitesites \"node functions/set-role.test.mjs\"",
    "test:email": "node --test functions/email.test.mjs",
    "test:prospects": "node --test functions/prospect-normalization.test.mjs",
    "test:dedupe": "node --test functions/prospect-deduplication.test.mjs",
    "test:migration": "node --test scripts/migrate-watcher-leads.test.mjs",
    "test:discovery": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/lead-discovery.test.mjs\"",
    "test:conversion": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/prospect-conversion.test.mjs\"",
    "test:outbound": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/outbound-calls.test.mjs\"",
    "test:consent": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/consent-grants.test.mjs\"",
    "test:pre-dial-screening": "node --test functions/pre-dial-screening.test.mjs",
    "test:outbound-webhook": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/outbound-webhook.test.mjs\"",
    "test:enrichment": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/lead-enrichment.test.mjs\"",
    "test:hybrid-dialer": "node --test functions/hybrid-call-orchestration.test.mjs functions/hybrid-capacity.test.mjs functions/hybrid-media-failsafe.test.mjs functions/hybrid-urls.test.mjs",
    "test:staff-workflows": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/hybrid-staff-workflows.test.mjs\"",
    "test:agent-runtime": "node --test functions/agent-runtime.test.mjs functions/agent-preview.test.mjs functions/agent-tools.test.mjs",
    "test:seller-voice": "node --test functions/seller-voice-config.test.mjs",
    "test:sales-readiness": "node --test functions/sales-readiness-eval.test.mjs",
    "test:conversation-evals": "node --test functions/conversation-evals.test.mjs",
    "evaluate:conversation-evals": "node scripts/evaluate-conversations.mjs",
    "test:realtime-lifecycle": "node --test src/admin/outbound/realtime-audio-lifecycle.test.mjs services/realtime-sideband/realtime-audio-lifecycle.test.mjs",
    "test:finance": "node --test src/admin/finance-calculations.test.mjs",
    "test:all": "npm run test:staging-infra && npm run test:staging-gate && node scripts/hybrid.mjs test-all",
    "test:all:raw": "npm run build && npm run test:finance && npm run test:accounts && npm run test:account-access && npm run test:role && npm run test:prospects && npm run test:dedupe && npm run test:migration && npm run test:email && npm run test:rules && npm run test:voice && npm run test:import && npm run test:lifecycle && npm run test:discovery && npm run test:conversion && npm run test:outbound && npm run test:consent && npm run test:pre-dial-screening && npm run test:outbound-webhook && npm run test:enrichment && npm run test:hybrid-dialer && npm run test:staff-workflows && npm run test:agent-runtime && npm run test:seller-voice && npm run test:sales-readiness && npm run test:conversation-evals && npm run test:calendar && npm run test:realtime-lifecycle && npm run test:sideband-poll && npm run test:sideband-warmup && npm run test:byte-persona && npm run test:byte-web && npm run test:bit-persona && npm run test:bit-chat && npm run test:crm && npm run test:inbound",
    "seed:outbound": "node scripts/seed-outbound.mjs",
    "role": "node scripts/set-role.mjs",
    "calendar": "node scripts/calendar-settings.mjs",
    "ship": "sh scripts/ship.sh",
    "start": "node server.js",
    "preview": "vite preview",
    "test:calendar": "node --test functions/booking-calendar.test.mjs",
    "test:accounts": "node --test functions/accounts.test.mjs",
    "test:account-access": "node --test functions/account-access.test.mjs",
    "test:sideband-poll": "node --test functions/hybrid-sideband-poll.test.mjs",
    "test:byte-persona": "node --test functions/byte-persona.test.mjs",
    "test:byte-web": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/byte-web-session.test.mjs\"",
    "test:bit-persona": "node --test functions/bit-persona.test.mjs",
    "test:bit-chat": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/bit-chat.test.mjs\"",
    "test:sideband-warmup": "node --test functions/hybrid-sideband-warmup.test.mjs",
    "test:crm": "node --test functions/flg-crm.test.mjs functions/flg-commission-sync.test.mjs src/admin/crm-calculations.test.mjs",
    "test:inbound": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/inbound-compliance.test.mjs\"",
    "test:staging-infra": "node --test functions/deployment-environment.test.mjs scripts/staging.test.mjs",
    "test:staging-gate": "firebase emulators:exec --only firestore --project demo-bitesites \"node functions/outbound-environment-gate.test.mjs\""
  },
  "dependencies": {
    "@twilio/voice-sdk": "2.18.3",
    "d3-geo": "^3.1.1",
    "express": "^5.1.0",
    "firebase": "^12.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "firebase-admin": "^14.2.0",
    "playwright": "^1.61.1",
    "vite": "^6.3.5"
  }
}
